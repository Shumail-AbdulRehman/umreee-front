# Local Vite development uses /api and its built-in proxy to localhost:8000.
VITE_API_BASE_URL=/api
# On Netlify, set this in the dashboard before building (include /api):
# VITE_API_BASE_URL=https://YOUR-ACTUAL-HEROKU-APP-URL.herokuapp.com/api
# VITE_* values are public. Never put API keys, database URLs, or secrets here.
